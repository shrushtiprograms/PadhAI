<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="?attr/colorSurface">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_email"
            android:contentDescription="Email verification"
            android:padding="12dp"
            android:background="@drawable/bg_dialog_icon"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Verify your code"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvOtpDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We've sent a 6-digit verification code to your email."
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.75"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/llOtpBoxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etOtp1"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_otp_input"
                android:gravity="center"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etOtp2"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_otp_input"
                android:gravity="center"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etOtp3"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_otp_input"
                android:gravity="center"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etOtp4"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_otp_input"
                android:gravity="center"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etOtp5"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_otp_input"
                android:gravity="center"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etOtp6"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_otp_input"
                android:gravity="center"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:maxLines="1"
                android:importantForAutofill="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOtpError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Verify code"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvOtpPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Didn't receive the code?"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResendOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Resend OTP"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
